# ============================================================================
# Local dev (npm run dev) — direct connection string, e.g. to the Postgres
# container from `docker compose up -d db` (docker-compose.yml, dev-only).
# Not used in production — the production `web` container builds this same
# variable itself from POSTGRES_USER/PASSWORD/DB below, pointed at the `db`
# service's Docker-internal hostname instead of localhost.
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# NextAuth — generate with `openssl rand -base64 32`. Use a different value
# in production than in dev; never reuse the dev secret.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seed script — bootstrap admin credentials (dev only; never set these two as
# permanent production env vars — see README's Setup section)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Public business contact details (read via src/lib/site-config.ts)
NEXT_PUBLIC_BUSINESS_PHONE=""
NEXT_PUBLIC_BUSINESS_WHATSAPP=""
NEXT_PUBLIC_BUSINESS_EMAIL=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""

# Public site URL — used for sitemap.xml, robots.txt, canonical URLs, and
# JSON-LD, and as part of src/lib/csrf.ts's Origin/Referer allow-list.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Test-only escape hatch for src/lib/rate-limit.ts's in-memory limiters
# (POST /api/contact, POST /api/upload(/video)) — lets the integration/
# edge-case test suites fire many requests in quick succession without
# tripping the limiter. NEVER set this in production — doing so disables
# rate limiting entirely on those routes. Leave unset by default.
RATE_LIMIT_DISABLED=""

# ============================================================================
# Docker Compose production stack (docker-compose.yml) — used by the `db` and
# `web` services and the `migrate`/`backup`/`certbot` one-off services. Not
# read by `npm run dev`. In production this file is generated on the VPS by
# .github/workflows/deploy.yml from GitHub Secrets — see README's
# "Deployment (Hostinger VPS + Docker)" section.
# ============================================================================
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# The domain nginx terminates TLS for and requests the Let's Encrypt cert for.
DOMAIN_NAME=""
