// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  brand       String
  weight      String?
  productType String?
  sku         String           @unique
  price       Int?
  images      String           @default("[]")
  inStock     Boolean          @default(true)
  featured    Boolean          @default(false)
  isHidden    Boolean          @default(false)
  category    Category         @relation(fields: [categoryId], references: [id])
  categoryId  String
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([brand])
}

model ProductVariant {
  id        String   @id @default(cuid())
  label     String
  price     Int
  inStock   Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
}

model Enquiry {
  id            String   @id @default(cuid())
  productId     String?
  name          String
  contactMethod String
  message       String
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([isCompleted])
}

// Singleton row (always fetched via findFirst) — holds sitewide config that
// isn't tied to a specific Product/Category, starting with the homepage hero
// carousel images.
model SiteSettings {
  id         String   @id @default(cuid())
  heroImages String   @default("[]")
  updatedAt  DateTime @updatedAt
}

// One business, multiple physical shops. Exactly one row should have
// isPrimary = true at any time — but the two halves of that invariant are
// enforced at different layers. "At most one": a Postgres partial unique
// index (`CREATE UNIQUE INDEX ... WHERE "isPrimary" = true`, added by
// migration 20260806120000_enforce_single_primary_and_active — Prisma's
// schema language can't express a partial index, so it has no equivalent
// here) genuinely guarantees this at the DB layer; a losing concurrent
// writer gets a clean 409 (P2002), never two primary rows. "At least one":
// still API-only (the PATCH/DELETE guards refuse to unset/delete the sole
// primary) — the unique index can't express a floor, only a ceiling, and
// the migration's repair step only demotes extras, it never promotes a row
// if a DB somehow reaches zero primaries.
// DRIFT HAZARD: the partial index has no equivalent in this file. Verified
// against Prisma 7.9.1 (isolated DB, `prisma migrate dev --create-only` and
// `prisma migrate status`): it does NOT currently propose dropping the
// index — it's silently ignored rather than reconciled, and status reports
// "up to date". That's undocumented Prisma behavior, not a guarantee, so
// still hand-review any future `prisma migrate dev` diff touching
// ShopLocation/FestivalBanner rather than accepting it blindly (see the
// migration.sql's own comment and .claude/context/architecture.md's
// matching note).
model ShopLocation {
  id             String   @id @default(cuid())
  name           String
  address        String
  phone          String
  whatsappNumber String
  email          String
  mapLink        String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum FestivalBannerMediaType {
  IMAGE
  VIDEO
}

// A small list of festival greeting banners (Diwali, Ganpati, etc.) — at
// most one is shown to visitors at a time. Unlike ShopLocation.isPrimary,
// zero active rows is a perfectly normal state (between festivals), so
// there's no "at least one must stay active" invariant here — only "at
// most one". Enforced BOTH at the API layer (src/app/api/festival-banners,
// via an updateMany-then-write $transaction) AND, since migration
// 20260806120000_enforce_single_primary_and_active, by a Postgres partial
// unique index (`CREATE UNIQUE INDEX ... WHERE "isActive" = true`) — same
// drift hazard as ShopLocation.isPrimary above; see that comment. A banner
// is either an image or a video, not both — mediaType says which,
// mediaPath points at whichever file was uploaded.
model FestivalBanner {
  id        String                  @id @default(cuid())
  label     String
  mediaType FestivalBannerMediaType @default(IMAGE)
  mediaPath String
  isActive  Boolean                 @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}
